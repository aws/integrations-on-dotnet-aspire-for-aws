<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The repository root nuget.config clears all package sources and only lists nuget.org, so this
    playground-local nuget.config re-adds nuget.org and a local feed. The local feed ("./packages")
    holds the locally packed Aspire.Hosting.AWS build produced by the pack helper (see README.md).
    The local build is packed with a unique 100.0.<seconds> version so it always wins the empty
    version float in aspire.config.json.
  -->
  <packageSources>
    <clear />
    <add key="local-aws" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
